<?xml version="1.0" encoding="utf-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="dh-explanationofbenefit-mcv-1"/>
  <url value="http://ns.electronichealth.net.au/fhir/StructureDefinition/dh-explanationofbenefit-mcv-1"/>
  <name value="DHExplanationofBenefitMCV"/>
  <title value="MHR Medical Conditions View Explanation of Benefit"/>
  <status value="draft"/>
  <publisher value="Australian Digital Health Agency"/>
  <contact>
    <telecom>
      <system value="email"/>
      <value value="help@digitalhealth.gov.au"/>
    </telecom>
  </contact>
  <description value="The purpose of this profile is to support an explanation of benefit for consolidated view of medical conditions and past medical history contained in a patient's My Health Record. It is based on the [ExplanationOfBenefit](https://hl7.org/fhir/R4/explanationofbenefit.html) resource and identifies the data structures and obligations that must be met when conforming to this profile."/>
  <copyright value="Copyright © 2024 Australian Digital Health Agency - All rights reserved. This content is licensed under a Creative Commons Attribution 4.0 International License. See https://creativecommons.org/licenses/by/4.0/." />
  <fhirVersion value="4.0.1" />
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="ExplanationOfBenefit"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/ExplanationOfBenefit"/>
  <derivation value="constraint"/>
  <differential>
    <element id="ExplanationOfBenefit">
      <path value="ExplanationOfBenefit"/>
      <short value="Record of Claim"/>
      <definition value="A record of the claim of an item claimed. Claim items include information about healthcare services provided to an individual that were partially or fully funded by the Australian Government run benefits scheme."/>
    </element>
    <element id="ExplanationOfBenefit.id">
      <path value="ExplanationOfBenefit.id"/>
      <min value="1"/>
    </element>
    <element id="ExplanationOfBenefit.status">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.status"/>
      <fixedCode value="active"/>  
      <mustSupport value="true"/>
    </element>
    <element id="ExplanationOfBenefit.type">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.type"/>
      <patternCodeableConcept>
        <coding>
          <system value="http://terminology.hl7.org/CodeSystem/claim-type"/>
          <code value="institutional"/>
          <display value="Institutional"/>   
        </coding>
      </patternCodeableConcept> 
      <mustSupport value="true"/>
      <binding>
        <strength value="required"/>
        <valueSet value="http://hl7.org/fhir/ValueSet/claim-type"/>
      </binding>
    </element>
    <element id="ExplanationOfBenefit.subType">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>    
      <path value="ExplanationOfBenefit.subType"/>
      <patternCodeableConcept>
        <coding>
          <system value="https://healthterminologies.gov.au/fhir/CodeSystem/australian-benefit-payment-category-1"/>
          <code value="mbs"/>
          <display value="MBS"/>
        </coding>
      </patternCodeableConcept>
      <mustSupport value="true"/>
      <binding>
        <strength value="required"/>
        <valueSet value="https://healthterminologies.gov.au/fhir/ValueSet/australian-medicare-benefit-claim-category-1"/>
      </binding>
    </element>
    <element id="ExplanationOfBenefit.use">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.use"/>
      <fixedCode value="claim"/>
      <mustSupport value="true"/>
    </element>
    <element id="ExplanationOfBenefit.patient">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.patient"/>
      <type>
        <code value="Reference"/>
        <targetProfile value="http://ns.electronichealth.net.au/fhir/StructureDefinition/dh-patient-mhr-1"/>
      </type>      
      <mustSupport value="true"/>
    </element>
    <element id="ExplanationOfBenefit.created">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.created"/>
      <mustSupport value="true"/>
    </element>
    <element id="ExplanationOfBenefit.provider">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.provider"/>
      <type>
        <code value="Reference"/>
        <targetProfile value="http://hl7.org.au/fhir/core/StructureDefinition/au-core-practitionerrole"/>
      </type>
      <mustSupport value="true"/>
    </element>
    <element id="ExplanationOfBenefit.priority">      
      <path value="ExplanationOfBenefit.priority"/> 
      <binding>
        <strength value="example"/>
        <valueSet value="http://hl7.org/fhir/ValueSet/process-priority"/>
      </binding>
    </element>
    <element id="ExplanationOfBenefit.outcome">
      <path value="ExplanationOfBenefit.outcome"/>      
      <fixedCode value="complete"/>
    </element>
    <element id="ExplanationOfBenefit.insurance">
      <path value="ExplanationOfBenefit.insurance"/>
      <max value="1"/>
    </element>
    <element id="ExplanationOfBenefit.insurance.focal">
      <path value="ExplanationOfBenefit.insurance.focal"/>
      <fixedBoolean value="true"/>
    </element>
    <element id="ExplanationOfBenefit.insurance.coverage.extension:dataAbsentReason">
      <path value="ExplanationOfBenefit.insurance.coverage.extension"/>
      <sliceName value="dataAbsentReason"/>
      <type>
        <code value="Extension"/>
        <profile value="http://hl7.org/fhir/StructureDefinition/data-absent-reason"/>
      </type>
    </element>
    <element id="ExplanationOfBenefit.insurance.coverage.extension:dataAbsentReason.valueCode">
      <path value="ExplanationOfBenefit.insurance.coverage.extension.valueCode"/>
      <fixedCode value="unknown"/>
    </element>
    <element id="ExplanationOfBenefit.item.sequence">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.item.sequence"/>
      <fixedPositiveInt value="1"/>
      <mustSupport value="true"/>
    </element>
    <element id="ExplanationOfBenefit.item.category">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.item.category"/>
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <min value="1"/>
      <patternCodeableConcept>
        <coding>
          <system value="https://healthterminologies.gov.au/fhir/CodeSystem/australian-benefit-payment-category-1"/>
          <code value="mbs"/>
          <display value="MBS"/>
        </coding>
        <text value="Medicare Benefits Schedule"/>
      </patternCodeableConcept>      
      <mustSupport value="true"/>
      <binding>
        <strength value="extensible"/>
        <valueSet value="https://healthterminologies.gov.au/fhir/ValueSet/australian-medicare-benefit-claim-category-1"/>
      </binding>
    </element>
    <element id="ExplanationOfBenefit.item.productOrService">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.item.productOrService"/>
      <short value="MBS Billing code"/>
      <definition value="The billing code the service was claimed with against the Australian Department of Health Modifications of MBS Item and DVA Fee Schedule Item (urn:oid:1.2.36.1.2001.1005.21)."/>
      <comment value="The code as instantiated may be padded with leading zeros when compared with the original (as published by the Department of Health)."/>
      <mustSupport value="true"/>
    </element>
    <element id="ExplanationOfBenefit.item.productOrService.coding.system">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.item.productOrService.coding.system"/>
      <fixedUri value="urn:oid:1.2.36.1.2001.1005.21"/>
      <min value="1"/>
      <mustSupport value="true"/>
    </element>
    <element id="ExplanationOfBenefit.item.productOrService.coding.code">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.item.productOrService.coding.code"/>
      <min value="1"/>
      <mustSupport value="true"/>
    </element>
    <element id="ExplanationOfBenefit.item.serviced[x]">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <type>
        <code value="date" />
      </type>
      <path value="ExplanationOfBenefit.item.serviced[x]"/>
      <min value="1"/>
      <mustSupport value="true"/>
    </element>
    <element id="ExplanationOfBenefit.item.location[x]">
      <extension url="http://hl7.org/fhir/StructureDefinition/obligation">
        <extension url="code">
          <valueCode value="SHALL:handle"/>
        </extension>
        <extension url="actor">
          <valueCanonical value="http://ns.electronichealth.net.au/fhir/ActorDefinition/mhr-gw-actor-requester"/>
        </extension>
      </extension>
      <path value="ExplanationOfBenefit.item.location[x]"/>
      <short value="Service in-hospital indicator"/>
      <definition value="When instantiated this element indicates the service was provided in a hospital"/>
      <comment value="When instantiated as a service in-hospital indicator this concept is equivalent to Australian Institute of Health and Welfare data element 604401 [Service event—Medicare in-hospital treatment indicator, yes/no code A](https://meteor.aihw.gov.au/content/index.phtml/itemId/604401)."/>
      <type>
        <code value="CodeableConcept" />
      </type>
      <patternCodeableConcept>
        <coding>
          <system value="http://terminology.hl7.org/CodeSystem/v3-RoleCode"/>
          <code value="HOSP"/>
        </coding>
      </patternCodeableConcept>
      <mustSupport value="true"/>
    </element>
  </differential>
</StructureDefinition>
